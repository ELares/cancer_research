*.aux
*.log
*.out
*.toc
*.ent
*.bbl
*.blg
*.synctex.gz

# Generated manuscript PDFs
article/drafts/*.pdf

# Local pipeline provenance log
analysis/provenance.jsonl

# Living review (#349): dated incremental indexes + delta changelogs are
# generated by the scheduled Action and uploaded as artifacts, not committed.
# The committed corpus/living/README.md documents the frozen-vs-living split.
corpus/living/20*/
analysis/living-review/

# Local-only outputs (e.g. named collaborator seed list, #541) — never committed
local/
corpus/atlas/raw/
corpus/atlas/records/
corpus/atlas/relations/
corpus/atlas/entities/
corpus/atlas/records_unindexed/
corpus/atlas/records_updates/
corpus/atlas/records_c04only/
corpus/atlas/comention/
# Build state, not analysis output: per-file resume records pointing at the
# gitignored data above. 25,370 lines that churn on every rebuild, and they buy
# nothing offline -- atlas_coverage.py exits without corpus/atlas/records/,
# which is gitignored, so it can never run from a fresh checkout anyway.
corpus/atlas/manifest.json
corpus/atlas/manifest-c04only.json
corpus/atlas/unindexed-manifest.json
corpus/atlas/records_updates/

# Corpus expansion working state (#corpus-expand).
# The identity index is ~780 MB of identifiers derived entirely from data this
# repo already points at, and the fetch state is a resumable cursor. Both are
# REBUILDABLE from `scripts/corpus_identity_index.py` and carry no information
# a reader needs, so they are generated rather than committed. The downloaded
# corpus itself never enters the repo at all -- it goes to external storage.
corpus/atlas/identity.sqlite*
corpus/atlas/expand_state.sqlite*

# The expansion crawl's live progress report. Regenerated on demand from the
# stored shards and stamped with the moment it was taken, so its hash changes
# every time it is refreshed -- committing it would make MANIFEST.sha256 stale
# on each regeneration and fail manifest-check on unrelated PRs. It is a
# dashboard, not a result: `python3 scripts/corpus_expand_report.py` rebuilds it
# in seconds. The final report is committed once the crawl is finished.
analysis/corpus-expansion.md
analysis/corpus-expansion.json
